# Local development
APP_ENV=development
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
LOCAL_HOST=127.0.0.1
LOCAL_PORT=5050
ENABLE_LOCAL_CONTACT_STORAGE=1
CONTACT_DELIVERY_MODE=local

# Public details
CONTACT_EMAIL=
LINKEDIN_URL=
GITHUB_URL=
YOUTUBE_URL=
FACEBOOK_URL=

# Production website
PUBLIC_BASE_URL=https://keycastro.onrender.com
TRUSTED_HOSTS=keycastro.onrender.com,.onrender.com

# Production contact form + private inbox
CONTACT_DELIVERY_MODE=database
DATABASE_URL=
OWNER_INBOX_TOKEN=
OWNER_TIMEZONE=Asia/Manila

# Optional SMTP notification only
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=1
SMTP_USE_TLS=0
