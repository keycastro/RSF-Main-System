# Local development
APP_ENV=development
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
LOCAL_HOST=127.0.0.1
LOCAL_PORT=5050
ENABLE_LOCAL_CONTACT_STORAGE=1
CONTACT_DELIVERY_MODE=local

# Add only verified public details before publishing.
CONTACT_EMAIL=
LINKEDIN_URL=
GITHUB_URL=
YOUTUBE_URL=
FACEBOOK_URL=

# Production website settings
PUBLIC_BASE_URL=
TRUSTED_HOSTS=

# Production contact form delivery
# Set CONTACT_DELIVERY_MODE=smtp in production.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=1
SMTP_USE_TLS=0
