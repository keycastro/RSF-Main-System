# Generated automatically by bootstrap.py on first setup.
# Do not commit or share your real .env file.
SECRET_KEY=replace-with-a-random-secret
RSF_CREDENTIAL_VAULT_KEY=replace-with-a-separate-random-secret
HOST=127.0.0.1
PORT=5078
SESSION_HOURS=8
TRUSTED_HOSTS=127.0.0.1,localhost
SESSION_COOKIE_SECURE=0
CLIENT_ATTACHMENT_DIR=
BACKUP_DIR=

# Unified public website
PUBLIC_BASE_URL=
CONTACT_EMAIL=
ENVIRONMENT_LABEL=Local

# One official RSF client email identity
RSF_EMAIL_NAME=Realty Systems Foundry
RSF_EMAIL_ADDRESS=
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=1
SMTP_USE_TLS=0
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_USE_SSL=1
IMAP_MAILBOX=INBOX

# Unified operations automation
AUTO_EMAIL_SYNC=1
EMAIL_SYNC_INTERVAL_SECONDS=60
FIRST_RESPONSE_SLA_MINUTES=60
CLIENT_MAX_ATTACHMENTS=5
CLIENT_MAX_FILE_MB=15
CLIENT_MAX_TOTAL_MB=25
AUTO_BACKUP_INTERVAL_HOURS=24
